# ============================================================
# Project Victoria - AI Model API Keys & Environment Variables
# Copy this file to .env and insert your API keys
# ============================================================

# Active AI Brain Model (gemini, gemini_pro, openrouter, opencode, groq, openai_gpt4o, local_fast)
VICTORIA_ACTIVE_MODEL="gemini"

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""

# OpenRouter / OpenCode API Key (Get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=""

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=""

# Groq Cloud API Key (https://console.groq.com/keys)
GROQ_API_KEY=""

# Sarvam AI API Key (https://dashboard.sarvam.ai)
SARVAM_API_KEY=""
